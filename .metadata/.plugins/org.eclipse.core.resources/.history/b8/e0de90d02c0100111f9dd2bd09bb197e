
public class LastNonRepeatingCharacter {
	
	public static String lastnonrepating(String str) {
		
		String result = "";
		for(int i =str.length()-1;i>=0;i++) {
			
			int count = 0;
			
			if(str.charAt(i)!= ' ') {
				
			for(int j=0;j<str.length()-1;j++) {
				
				if(str.charAt(i) == str.charAt(j) && i!=j) {
					
					count++;
					break;
				}
			}
			}
			
			if(count == 0) {
				result += str.charAt(i);
				break;
			}
		}
		
		
		
		
		
		
		
		return "";
	}

}
