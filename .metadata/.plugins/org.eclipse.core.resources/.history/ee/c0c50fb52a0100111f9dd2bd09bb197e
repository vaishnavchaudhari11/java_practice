
public class FirstNonRepetatingcharacter {
	
	public String firstnonrepeat(String str) {
		String result;
		for(int i=0;i<str.length();i++) {
			
			int count = 0;
			for(int j=0;j<str.length();j++) {
				
				if(str.charAt(i) == str.charAt(j) && i!=j) {
					count++;
					break;
					
				}
			}
			
			if(count == 0) {
				result =+ str.charAt(i);
			}
		}
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		return "";
	}

}
