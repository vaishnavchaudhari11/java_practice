
public class HighestOccuredCharacter {
	
	public static void highestoccurchar(String str) {
		
		String result ="";
		for(int i=0;i<str.length();i++) {
			
			int count =1;
			int max =0;
			for(int j=i+1;j<str.length();j++) {
				
				if(str.charAt(i) == str.charAt(j)) {
					count++;
				}
			}
			
			if(count > max) {
				max = count;
				result = str.charAt(i);
			}
		}
	}

}
